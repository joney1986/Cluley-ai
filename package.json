{
  "name": "real-time-transcriber",
  "version": "1.0.0",
  "description": "A desktop application for real-time meeting transcription and summarization.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npx electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "28.0.0",
    "electron-builder": "26.0.12"
  },
  "dependencies": {
    "recordrtc": "^5.6.2"
  },
  "build": {
    "appId": "com.example.realtimetranscriber",
    "productName": "RealTimeTranscriber",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "package.json",
      "node_modules/"
    ],
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
